<?xml version="1.0" encoding="UTF-8"?>

<project name="Larva Seconds Lost External Module Builder" basedir="." default="INSTALL_DEPLOYMENT">
    <description>
        SDK-compatible Ant builder for the Larva Seconds Lost Scelight external module.
    </description>

    <property name="projectName" value="LarvaSecondsLostExtMod" />
    <property name="srcFolder" value="src" />
    <property name="binFolder" value="bin" />
    <property name="customLibsFolder" value="lib" />
    <property name="testFolder" value="test" />
    <property name="testBinFolder" value="bin-test" />
    <property name="testLibsFolder" value="test-lib" />
    <property name="releaseFolder" value="release" />
    <property name="releaseResourcesFolder" value="${releaseFolder}/resources" />
    <property name="releaseBuildFolder" value="${releaseFolder}/Scelight" />
    <property name="releasePropertiesFile" value="${releaseFolder}/release.properties" />
    <property name="deploymentFolder" value="${releaseFolder}/deployment" />
    <!-- Machine-specific settings (scelightFolder, pagesRepoFolder). Gitignored; template: release/local.properties.example. -->
    <property name="localPropertiesFile" value="${releaseFolder}/local.properties" />

    <target name="INIT_PROPERTIES">
        <!-- Loaded first: Ant keeps the first value set, so -D and local.properties win over release.properties. -->
        <property file="${localPropertiesFile}" />
        <property file="${releasePropertiesFile}" />

        <condition property="version" value="${version.major}.${version.minor}" else="${version.major}.${version.minor}.${version.revision}">
            <equals arg1="${version.revision}" arg2="0" />
        </condition>

        <property name="extModApiJar" value="../ScelightExtModSDK/Scelight-ext-mod-api/${api.version}/lib/scelight-ext-mod-api-${api.version}.jar" />
        <property name="versionFolder" value="${releaseBuildFolder}/mod-x/${folder}/${version}" />
        <property name="deploymentFileName" value="${deploymentName}-${version}.zip" />
        <property name="deploymentFile" value="${deploymentFolder}/${deploymentFileName}" />
        <!-- Defined here, not at top level: ${extModApiJar} only exists after the properties above are set (S04 tests use SDK types). -->
        <path id="testClasspath">
            <pathelement location="${testBinFolder}" />
            <pathelement location="${binFolder}" />
            <pathelement location="${extModApiJar}" />
            <fileset dir="${customLibsFolder}" includes="**/*.jar" />
            <fileset dir="${testLibsFolder}" includes="**/*.jar" />
        </path>
    </target>

    <target name="CLEAN" depends="INIT_PROPERTIES" description="Removes generated build outputs.">
        <delete dir="${binFolder}" />
        <delete dir="${testBinFolder}" />
        <delete dir="${releaseBuildFolder}" />
    </target>

    <target name="COMPILE" depends="INIT_PROPERTIES" description="Compiles the module with Java 7 source and target compatibility.">
        <available file="${extModApiJar}" property="extModApiJarPresent" />
        <fail message="Scelight External Module API jar not found: ${extModApiJar}" unless="extModApiJarPresent" />

        <delete dir="${binFolder}" />
        <mkdir dir="${binFolder}" />

        <copy todir="${binFolder}" preservelastmodified="true">
            <fileset dir="${srcFolder}" excludes="**/*.java" />
        </copy>

        <javac srcdir="${srcFolder}" destdir="${binFolder}" source="1.7" target="1.7" encoding="UTF-8" debug="true" includeantruntime="false">
            <classpath>
                <pathelement location="${extModApiJar}" />
                <fileset dir="${customLibsFolder}" includes="**/*.jar" />
            </classpath>
        </javac>
    </target>

    <!-- Test targets. Test jars live in test-lib/ (never lib/): COMPILE and BUILD_RELEASE use lib/**/*.jar.
         BUILD_RELEASE does not depend on these targets and never packs bin-test/ or test-lib/. -->

    <target name="COMPILE_TESTS" depends="COMPILE" description="Compiles the unit tests (Java 7 source level) into bin-test.">
        <delete dir="${testBinFolder}" />
        <mkdir dir="${testBinFolder}" />

        <javac srcdir="${testFolder}" destdir="${testBinFolder}" source="1.7" target="1.7" encoding="UTF-8" debug="true" includeantruntime="false">
            <classpath refid="testClasspath" />
        </javac>
    </target>

    <target name="TEST" depends="COMPILE_TESTS" description="Compiles and runs all *Test classes with JUnit 4; fails the build on any failure.">
        <pathconvert property="testClassNames" pathsep=" ">
            <fileset dir="${testFolder}" includes="**/*Test.java" />
            <chainedmapper>
                <regexpmapper from="^\Q${basedir}${file.separator}${testFolder}${file.separator}\E(.*)\.java$$" to="\1" />
                <packagemapper from="*" to="*" />
            </chainedmapper>
        </pathconvert>
        <fail message="No *Test classes found in ${testFolder}">
            <condition><equals arg1="${testClassNames}" arg2="" /></condition>
        </fail>

        <java classname="org.junit.runner.JUnitCore" fork="true" failonerror="true" classpathref="testClasspath">
            <arg line="${testClassNames}" />
        </java>
    </target>

    <!-- Integration golden (E17-S12): needs the installed Scelight (parser jars) and Java 8, so it is NOT part of TEST.
         Run: ant TEST_GOLDEN_MULTI   (override the JVM with -Dgolden.java=/path/to/java8/bin/java)
         Regenerate: ant GOLDEN_MULTI_REGENERATE, review the diff, commit it manually. -->
    <property name="golden.java" value="/usr/lib/jvm/java-8-openjdk-amd64/bin/java" />
    <property name="goldenMultiFile" value="${testFolder}/golden/epic17-multi-queensMoved.txt" />
    <property name="goldenMultiActual" value="${testBinFolder}/epic17-multi-queensMoved.actual.txt" />
    <property name="goldenMultiViewActual" value="${testBinFolder}/epic17-multi-queensMoved.view.txt" />

    <target name="REQUIRE_SCELIGHT_FOLDER" depends="INIT_PROPERTIES">
        <fail unless="scelightFolder"
              message="scelightFolder is not set. Copy release/local.properties.example to release/local.properties and set it, or pass -DscelightFolder=/path/to/Scelight/" />
    </target>

    <target name="GOLDEN_MULTI_RUN" depends="COMPILE,REQUIRE_SCELIGHT_FOLDER" description="Runs the headless --multi dump over benchmark-data/queensMoved into bin-test.">
        <mkdir dir="${testBinFolder}" />
        <java jvm="${golden.java}" classname="hu.aleks.larvasecondslostextmod.LarvaMultiAnalysisCli" fork="true" failonerror="true"
              output="${goldenMultiActual}" error="${testBinFolder}/epic17-multi-queensMoved.stderr.txt">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
                <fileset dir="${customLibsFolder}" includes="**/*.jar" />
                <fileset dir="${scelightFolder}/mod" includes="app/*/*.sldat app-libs/*/*.sldat launcher/*/*.sldat sc2-t/*/*.sldat sc2-bd/*/*.sldat" />
            </classpath>
            <arg value="--multi" />
            <arg value="../benchmark-data/queensMoved" />
            <arg value="--scelight-app-dir" />
            <arg value="${scelightFolder}" />
        </java>
    </target>

    <!-- E17-S15 criterion 8: the same run with the view-model flag prints the multi page's display model; LarvaMultiViewGoldenCheck compares
         every cell string with the formatted values of the golden dump. -->
    <target name="GOLDEN_MULTI_VIEW_RUN" depends="COMPILE,REQUIRE_SCELIGHT_FOLDER" description="Runs the headless --multi --view-model dump over benchmark-data/queensMoved into bin-test.">
        <mkdir dir="${testBinFolder}" />
        <java jvm="${golden.java}" classname="hu.aleks.larvasecondslostextmod.LarvaMultiAnalysisCli" fork="true" failonerror="true"
              output="${goldenMultiViewActual}" error="${testBinFolder}/epic17-multi-queensMoved.view.stderr.txt">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
                <fileset dir="${customLibsFolder}" includes="**/*.jar" />
                <fileset dir="${scelightFolder}/mod" includes="app/*/*.sldat app-libs/*/*.sldat launcher/*/*.sldat sc2-t/*/*.sldat sc2-bd/*/*.sldat" />
            </classpath>
            <arg value="--multi" />
            <arg value="../benchmark-data/queensMoved" />
            <arg value="--view-model" />
            <arg value="--scelight-app-dir" />
            <arg value="${scelightFolder}" />
        </java>
    </target>

    <target name="TEST_GOLDEN_MULTI" depends="COMPILE_TESTS,GOLDEN_MULTI_RUN,GOLDEN_MULTI_VIEW_RUN" description="Diffs the --multi dump against test/golden/epic17-multi-queensMoved.txt and checks the view-model cells against it (needs Scelight and Java 8).">
        <condition property="goldenMultiMatches">
            <filesmatch file1="${goldenMultiFile}" file2="${goldenMultiActual}" />
        </condition>
        <fail message="Multi dump differs from the golden: diff ${goldenMultiFile} ${goldenMultiActual}" unless="goldenMultiMatches" />
        <echo>Multi dump matches the golden.</echo>
        <java classname="hu.aleks.larvasecondslostextmod.LarvaMultiViewGoldenCheck" fork="true" failonerror="true" classpathref="testClasspath">
            <arg value="${goldenMultiFile}" />
            <arg value="${goldenMultiViewActual}" />
        </java>
    </target>

    <target name="GOLDEN_MULTI_REGENERATE" depends="GOLDEN_MULTI_RUN" description="Overwrites the golden with the current dump (review and commit manually).">
        <copy file="${goldenMultiActual}" tofile="${goldenMultiFile}" overwrite="true" />
    </target>

    <target name="BUILD_RELEASE" depends="PACKAGE_RELEASE,CHECK_RELEASE" description="Creates a release and deployment of the external module, then checks it." />

    <target name="PACKAGE_RELEASE" depends="COMPILE" description="Creates a release and deployment of the external module (no checks; use BUILD_RELEASE).">
        <tstamp>
            <format property="date" pattern="yyyy-MM-dd'T'HH:mm:ss.SSSXXX"/>
        </tstamp>

        <propertyfile file="${releasePropertiesFile}">
            <entry key="buildNumber" type="int" default="0" operation="+" />
        </propertyfile>

        <delete dir="${releaseBuildFolder}" />
        <mkdir dir="${versionFolder}" />
        <mkdir dir="${deploymentFolder}" />

        <copy todir="${versionFolder}" preservelastmodified="true">
            <fileset dir="${customLibsFolder}" includes="**/*.jar" />
        </copy>

        <property name="manifestFile" value="${versionFolder}/Scelight-mod-x-manifest.xml" />
        <copy tofile="${manifestFile}" preservelastmodified="true" file="${releaseResourcesFolder}/Scelight-mod-x-manifest-template.xml" />
        <replace file="${manifestFile}" propertyfile="${releasePropertiesFile}" encoding="UTF-8">
            <replacefilter token="@name@" property="name" />
            <replacefilter token="@version.major@" property="version.major" />
            <replacefilter token="@version.minor@" property="version.minor" />
            <replacefilter token="@version.revision@" property="version.revision" />
            <replacefilter token="@buildNumber@" property="buildNumber" />
            <replacefilter token="@folder@" property="folder" />
            <replacefilter token="@api.version.major@" property="api.version.major" />
            <replacefilter token="@api.version.minor@" property="api.version.minor" />
            <replacefilter token="@api.version.revision@" property="api.version.revision" />
        </replace>
        <replace file="${manifestFile}" token="@date@" value="${date}" encoding="UTF-8"/>

        <jar destfile="${versionFolder}/${folder}.jar">
            <fileset dir="${binFolder}" excludes="**/package.html" />
        </jar>

        <echo>External Module release build successful, placed in folder: ${releaseBuildFolder}</echo>

        <delete>
            <fileset dir="${deploymentFolder}" includes="${deploymentName}-*.zip" />
            <fileset file="${deploymentFolder}/module.xml" />
        </delete>

        <zip destfile="${deploymentFile}" basedir="${releaseBuildFolder}/.." includes="Scelight/**" />

        <property name="moduleXmlFile" value="${deploymentFolder}/module.xml" />
        <copy tofile="${moduleXmlFile}" preservelastmodified="true" file="${releaseResourcesFolder}/module-template.xml" />
        <replace file="${moduleXmlFile}" propertyfile="${releasePropertiesFile}" encoding="UTF-8">
            <replacefilter token="@name@" property="name" />
            <replacefilter token="@version.major@" property="version.major" />
            <replacefilter token="@version.minor@" property="version.minor" />
            <replacefilter token="@version.revision@" property="version.revision" />
            <replacefilter token="@folder@" property="folder" />
            <replacefilter token="@archiveBaseUrl@" property="archiveBaseUrl" />
        </replace>
        <replace file="${moduleXmlFile}" token="@archiveFile@" value="${deploymentFileName}" encoding="UTF-8"/>
        <checksum file="${deploymentFile}" algorithm="SHA-256" property="archiveSha256"/>
        <replace file="${moduleXmlFile}" token="@archiveSha256@" value="${archiveSha256}" encoding="UTF-8"/>
        <length file="${deploymentFile}" property="archiveSize"/>
        <replace file="${moduleXmlFile}" token="@archiveSize@" value="${archiveSize}" encoding="UTF-8"/>
        <java classpath="../ScelightExtModSDK/lib-sdk/sdk-tools.jar" classname="hu.sltool.extmodsdk.InjectModuleFileList">
            <arg file="${moduleXmlFile}" />
            <arg file="${deploymentFile}" />
        </java>
    </target>

    <!-- E18-S05: the deployment is published to every user, so stop on placeholder URLs, personal paths and dev leftovers. -->
    <target name="CHECK_RELEASE" depends="INIT_PROPERTIES" description="Fails if the deployment has placeholder URLs, personal paths or dev leftovers.">
        <property name="moduleXmlFile" value="${deploymentFolder}/module.xml" />
        <property name="lintFolder" value="${releaseFolder}/lint-tmp" />

        <available file="${deploymentFile}" property="lintDeploymentPresent" />
        <fail unless="lintDeploymentPresent" message="No deployment to check: ${deploymentFile}. Run PACKAGE_RELEASE first." />

        <condition property="lintBadBaseUrl">
            <not>
                <matches string="${archiveBaseUrl}" pattern="^https://minetonight\.github\.io/.+/$" />
            </not>
        </condition>
        <fail if="lintBadBaseUrl" message="archiveBaseUrl must start with https://minetonight.github.io/ and end with /, but is: ${archiveBaseUrl}" />

        <delete dir="${lintFolder}" />
        <unzip src="${deploymentFile}" dest="${lintFolder}/zip" />
        <unzip dest="${lintFolder}/jar">
            <fileset dir="${lintFolder}/zip" includes="**/${folder}.jar" />
        </unzip>
        <copy file="${moduleXmlFile}" todir="${lintFolder}" />

        <fileset id="lintTextHits" dir="${lintFolder}" excludes="zip/**/*.jar">
            <or>
                <contains text="example.invalid" />
                <contains text="/home/" />
                <contains text="/Users/" />
                <contains text="C:\Users\" casesensitive="false" />
            </or>
        </fileset>
        <pathconvert refid="lintTextHits" property="lintTextHitList" pathsep="${line.separator}  " setonempty="false" />
        <fail if="lintTextHitList" message="Release contains a placeholder URL or a personal path (example.invalid, /home/, /Users/, C:\Users\) in:${line.separator}  ${lintTextHitList}${line.separator}Files are under ${lintFolder}." />

        <fileset id="lintLeftoverHits" dir="${lintFolder}" includes="**/*.log **/*Test.class **/*Tests.class **/*.SC2Replay **/*-dev-dump*.txt" />
        <pathconvert refid="lintLeftoverHits" property="lintLeftoverHitList" pathsep="${line.separator}  " setonempty="false" />
        <fail if="lintLeftoverHitList" message="Release contains dev leftovers (logs, test classes, replays, dumps):${line.separator}  ${lintLeftoverHitList}" />

        <delete dir="${lintFolder}" />
        <echo>Release check passed: ${deploymentFileName}</echo>
    </target>

    <!-- E18-S07: copies a checked release into the local clone of the GitHub Pages repo. Never pushes: publishing reaches every
         user, so a person reviews the diff and pushes (see RELEASING.md). -->
    <target name="PUBLISH_RELEASE" depends="BUILD_RELEASE" description="Copies the release into the GitHub Pages clone (pagesRepoFolder); does not push.">
        <fail unless="pagesRepoFolder"
              message="pagesRepoFolder is not set. Clone https://github.com/minetonight/minetonight.github.io and set pagesRepoFolder in release/local.properties." />
        <available file="${pagesRepoFolder}/.git" type="dir" property="pagesRepoIsGit" />
        <fail unless="pagesRepoIsGit" message="pagesRepoFolder is not a git clone: ${pagesRepoFolder}" />

        <property name="pagesTargetFolder" value="${pagesRepoFolder}/scelight/${folder}" />
        <available file="${pagesTargetFolder}/${deploymentFileName}" property="pagesZipExists" />
        <fail if="pagesZipExists"
              message="${deploymentFileName} is already published. Published zips are never replaced: bump version.* in release/release.properties." />

        <java classname="hu.aleks.larvasecondslostextmod.update.ReleaseTool" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
            </classpath>
            <arg value="check-newer" />
            <arg file="${deploymentFolder}/module.xml" />
            <arg file="${pagesTargetFolder}/module.xml" />
        </java>

        <mkdir dir="${pagesTargetFolder}" />
        <copy file="${deploymentFile}" todir="${pagesTargetFolder}" preservelastmodified="true" />
        <copy file="${deploymentFolder}/module.xml" todir="${pagesTargetFolder}" overwrite="true" />
        <copy todir="${pagesTargetFolder}/img" overwrite="true">
            <fileset dir="${releaseFolder}/site/img" />
        </copy>

        <java classname="hu.aleks.larvasecondslostextmod.update.ReleaseTool" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
            </classpath>
            <arg value="page" />
            <arg file="${releaseFolder}/site/index-template.html" />
            <arg file="${pagesTargetFolder}/index.html" />
            <arg file="${deploymentFolder}/module.xml" />
        </java>

        <echo>Copied ${deploymentFileName}, module.xml and index.html to ${pagesTargetFolder}</echo>
        <echo>Review and publish (this reaches every user):</echo>
        <echo>  cd "${pagesRepoFolder}"</echo>
        <echo>  git status &amp;&amp; git diff --stat</echo>
        <echo>  git add scelight/${folder}</echo>
        <echo>  git commit -m "Larva Seconds Lost ${version}"</echo>
        <echo>  git push</echo>
        <echo>Then, after GitHub Pages has deployed (about 1 minute): ant SMOKE_CHECK_RELEASE</echo>
    </target>

    <!-- Updates only the landing page and its images for the version that is already published (no build, no zip, no
         module.xml change). The release date stays the one of the published zip. Never pushes. -->
    <target name="PUBLISH_SITE" depends="COMPILE" description="Updates index.html and images in the GitHub Pages clone for the published version; does not push.">
        <fail unless="pagesRepoFolder"
              message="pagesRepoFolder is not set. Clone https://github.com/minetonight/minetonight.github.io and set pagesRepoFolder in release/local.properties." />
        <property name="pagesTargetFolder" value="${pagesRepoFolder}/scelight/${folder}" />
        <available file="${pagesTargetFolder}/module.xml" property="pagesModuleXmlExists" />
        <fail unless="pagesModuleXmlExists" message="Nothing published yet in ${pagesTargetFolder}. Use PUBLISH_RELEASE for the first release." />
        <loadfile property="publishedArchiveName" srcfile="${pagesTargetFolder}/module.xml">
            <filterchain>
                <linecontains>
                    <contains value="&lt;archiveFile " />
                </linecontains>
                <replaceregex pattern=".*path=&quot;([^&quot;]+)&quot;.*" replace="\1" />
                <striplinebreaks />
            </filterchain>
        </loadfile>

        <copy todir="${pagesTargetFolder}/img" overwrite="true">
            <fileset dir="${releaseFolder}/site/img" />
        </copy>
        <java classname="hu.aleks.larvasecondslostextmod.update.ReleaseTool" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
            </classpath>
            <arg value="page" />
            <arg file="${releaseFolder}/site/index-template.html" />
            <arg file="${pagesTargetFolder}/index.html" />
            <arg file="${pagesTargetFolder}/module.xml" />
            <arg file="${pagesTargetFolder}/${publishedArchiveName}" />
        </java>
        <echo>Updated index.html and img/ in ${pagesTargetFolder}. Review and publish:</echo>
        <echo>  cd "${pagesRepoFolder}"</echo>
        <echo>  git status &amp;&amp; git diff --stat</echo>
        <echo>  git add scelight/${folder}</echo>
        <echo>  git commit -m "Larva Seconds Lost page update"</echo>
        <echo>  git push</echo>
    </target>

    <target name="SMOKE_CHECK_RELEASE" depends="COMPILE" description="Downloads the live module.xml and zip and installs them into a temp folder, like a user's Scelight would.">
        <java classname="hu.aleks.larvasecondslostextmod.update.ReleaseTool" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${binFolder}" />
                <pathelement location="${extModApiJar}" />
            </classpath>
            <arg value="smoke" />
        </java>
    </target>

    <target name="INSTALL_DEPLOYMENT" depends="REQUIRE_SCELIGHT_FOLDER,BUILD_RELEASE" description="Installs the deployment into a Scelight folder after replacing older versions.">
        <echo>Checking Scelight folder: ${scelightFolder}</echo>

        <basename file="${scelightFolder}" property="scelightFolderName" />
        <fail message="The Scelight folder is not named Scelight: ${scelightFolderName}">
            <condition>
                <not>
                    <equals arg1="${scelightFolderName}" arg2="Scelight" />
                </not>
            </condition>
        </fail>

        <available file="${scelightFolder}" type="dir" property="scelightFolderPresent"/>
        <fail message="Scelight folder does not exist: ${scelightFolder}" unless="scelightFolderPresent" />

        <condition property="isRealScelightFolder">
            <or>
                <available file="${scelightFolder}/Scelight.exe" />
                <available file="${scelightFolder}/Scelight-linux.sh" />
                <available file="${scelightFolder}/Scelight-os-x.command" />
            </or>
        </condition>
        <fail message="Scelight folder does not appear to be a real Scelight folder (no known launcher file was found): ${scelightFolder}" unless="isRealScelightFolder" />

        <delete dir="${scelightFolder}/mod-x/${folder}" />
        <unzip src="${deploymentFile}" dest="${scelightFolder}/.." />
    </target>

    <target name="BACKUP_PROJECT" depends="INIT_PROPERTIES" description="Creates a project backup zip excluding the bin folder.">
        <condition property="datePattern" value="-yyyyMMdd-HHmmss" else="">
            <equals arg1="${includeTstampInBackup}" arg2="true" />
        </condition>
        <tstamp>
            <format property="date" pattern="${datePattern}"/>
        </tstamp>

        <mkdir dir="${backupFolder}" />
        <property name="destBackupFile" value="${backupFolder}/${projectName}-${version}-project${date}.zip" />

        <delete file="${destBackupFile}" />
        <zip destfile="${destBackupFile}" basedir=".." includes="${projectName}/" excludes="${projectName}/bin/" />

        <echo>Project backup ready in file: ${destBackupFile}</echo>
    </target>

    <target name="1_BUILD_RELEASE" depends="BUILD_RELEASE" />
    <target name="2_INSTALL_DEPLOYMENT" depends="INSTALL_DEPLOYMENT" />
    <target name="Z_BACKUP_PROJECT" depends="BACKUP_PROJECT" />
</project>
